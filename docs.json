{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Intrusive Robotics",
  "description": "Product documentation and usage guides for Intrusive Robotics hardware.",
  "colors": {
    "primary": "#FF6600",
    "light": "#FF8A3D",
    "dark": "#CC5200"
  },
  "favicon": {
    "light": "/images/Favicon.png",
    "dark": "/images/Favicon.png"
  },
  "logo": {
    "light": "/images/ir-logo-lockup-v4.png",
    "dark": "/images/ir-logo-lockup-v4.png",
    "href": "/"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Barlow",
    "heading": {
      "family": "Barlow Condensed",
      "weight": 600
    },
    "body": {
      "family": "Barlow"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "banner": {
    "content": "Delta is **compatible with VESC® software** but is not a VESC-branded product and is not affiliated with or endorsed by Benjamin Vedder or the VESC project.",
    "dismissible": true,
    "type": "info"
  },
  "navigation": {
    "groups": [
      {
        "group": "Delta GaN ESC",
        "icon": "microchip",
        "pages": [
          "guides/quickstart",
          {
            "group": "Architecture",
            "pages": [
              "reference/architecture",
              "reference/boot-and-startup",
              "reference/hardware-abstraction",
              "reference/configuration-storage"
            ],
            "icon": "sitemap"
          },
          {
            "group": "Motor control",
            "icon": "bolt",
            "pages": [
              "reference/motor/mc-interface",
              "reference/motor/mcpwm-foc",
              "reference/motor/foc-math",
              "reference/motor/virtual-motor"
            ]
          },
          {
            "group": "Sensing",
            "icon": "compass",
            "pages": [
              "reference/sensing/encoders",
              "reference/sensing/imu",
              "reference/sensing/bms"
            ]
          },
          {
            "group": "Communication",
            "icon": "tower-broadcast",
            "pages": [
              "documentation/comm_can",
              "reference/comm/usb",
              "reference/comm/packet-protocol",
              "reference/comm/commands",
              "reference/comm/terminal",
              "reference/comm/logging"
            ]
          },
          {
            "group": "Applications",
            "icon": "layer-group",
            "pages": [
              "reference/applications/overview",
              "reference/applications/ppm",
              "reference/applications/adc",
              "reference/applications/uart",
              "reference/applications/custom-app"
            ]
          },
          {
            "group": "Scripting",
            "icon": "scroll",
            "pages": [
              "reference/lispbm/overview",
              "reference/lispbm/vesc-extensions",
              "reference/lispbm/examples"
            ]
          },
          {
            "group": "Releases",
            "icon": "tag",
            "pages": [
              "releases/changelog",
              "releases/upstream-changelog"
            ]
          },
          {
            "group": "Legal",
            "icon": "scale-balanced",
            "pages": [
              "legal/license",
              "legal/provenance",
              "legal/trademarks"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "intrusiverobotics.com",
        "href": "https://intrusiverobotics.com"
      },
      {
        "type": "github",
        "href": "https://github.com/IntrusiveRobotics/Delta"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download firmware",
      "href": "https://github.com/IntrusiveRobotics/Delta/releases/latest"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/IntrusiveRobotics",
      "website": "https://intrusiverobotics.com"
    },
    "links": [
      {
        "header": "Delta GaN ESC",
        "items": [
          {
            "label": "Quickstart",
            "href": "/guides/quickstart"
          },
          {
            "label": "Firmware reference",
            "href": "/reference/architecture"
          },
          {
            "label": "CAN bus",
            "href": "/documentation/comm_can"
          }
        ]
      },
      {
        "header": "Releases",
        "items": [
          {
            "label": "Changelog",
            "href": "/releases/changelog"
          },
          {
            "label": "Upstream changelog",
            "href": "/releases/upstream-changelog"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "GPL v3.0", "href": "/legal/license" },
          { "label": "Provenance", "href": "/legal/provenance" },
          { "label": "Trademarks", "href": "/legal/trademarks" }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search the documentation"
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"],
    "display": "header"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "navigable"
  },
  "variables": {
    "firmwareVersion": "IR_FW1_5",
    "vescBase": "6.05",
    "mcu": "STM32F405RGT6",
    "buildTarget": "fw_vesc_gan"
  }
}
