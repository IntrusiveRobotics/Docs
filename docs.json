{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Intrusive Robotics Delta",
  "description": "Firmware documentation for the Intrusive Robotics Delta, a compact high-power GaN motor controller compatible with VESC software.",
  "colors": {
    "primary": "#FF6600",
    "light": "#FF8A3D",
    "dark": "#CC5200"
  },
  "favicon": {
    "light": "/images/Favicon.png",
    "dark": "/images/Favicon.png"
  },
  "logo": {
    "light": "/images/ir-logo-lockup-v4.png",
    "dark": "/images/ir-logo-lockup-v4.png",
    "href": "https://intrusiverobotics.com"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Barlow",
    "heading": {
      "family": "Barlow Condensed",
      "weight": 600
    },
    "body": {
      "family": "Barlow"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "banner": {
    "content": "Delta is **compatible with VESC® software** but is not a VESC-branded product and is not affiliated with or endorsed by Benjamin Vedder or the VESC project.",
    "dismissible": true,
    "type": "info"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/IntrusiveRobotics/Delta"
        },
        {
          "anchor": "Latest release",
          "icon": "download",
          "href": "https://github.com/IntrusiveRobotics/Delta/releases/latest"
        },
        {
          "anchor": "Upstream VESC project",
          "icon": "code-branch",
          "href": "https://github.com/vedderb/bldc"
        }
      ],
      "tabs": [
        {
          "tab": "Products",
          "icon": "1",
          "href": "https://docs.intrusiverobotics.com/products"
        }
      ]
    },
    "pages": [
      "index",
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "guides/quickstart"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "intrusiverobotics.com",
        "href": "https://intrusiverobotics.com"
      },
      {
        "type": "github",
        "href": "https://github.com/IntrusiveRobotics/Delta"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download firmware",
      "href": "https://github.com/IntrusiveRobotics/Delta/releases/latest"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/IntrusiveRobotics",
      "website": "https://intrusiverobotics.com"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          { "label": "Quickstart", "href": "/guides/quickstart" },
          { "label": "Building", "href": "/build/building" },
          { "label": "Flashing", "href": "/build/flashing" },
          { "label": "CAN bus", "href": "/documentation/comm_can" }
        ]
      },
      {
        "header": "Project",
        "items": [
          { "label": "Source", "href": "https://github.com/IntrusiveRobotics/Delta" },
          { "label": "Releases", "href": "https://github.com/IntrusiveRobotics/Delta/releases" },
          { "label": "Changelog", "href": "/releases/changelog" }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "GPL v3.0", "href": "/legal/license" },
          { "label": "Provenance", "href": "/legal/provenance" },
          { "label": "Trademarks", "href": "/legal/trademarks" }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search the Delta firmware docs"
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"],
    "display": "header"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "navigable"
  },
  "variables": {
    "firmwareVersion": "IR_FW1_5",
    "vescBase": "6.05",
    "mcu": "STM32F405RGT6",
    "buildTarget": "fw_vesc_gan"
  }
}
